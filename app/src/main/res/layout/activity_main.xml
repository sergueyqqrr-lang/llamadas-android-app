<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Configura tu número para empezar"
        android:textSize="14sp"
        android:layout_marginBottom="24dp" />

    <EditText
        android:id="@+id/etMyPhone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Tu número de teléfono"
        android:inputType="phone" />

    <Button
        android:id="@+id/btnRegister"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Guardar mi número"
        android:layout_marginTop="8dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#DDDDDD"
        android:layout_marginVertical="32dp" />

    <EditText
        android:id="@+id/etTargetPhone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Número al que quieres llamar"
        android:inputType="phone" />

    <Button
        android:id="@+id/btnCall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Llamar"
        android:layout_marginTop="8dp" />

</LinearLayout>
